{
  "manifest_version": 3,
  "name": "华科邮箱链接转换器",
  "version": "1.0.0",
  "description": "识别华科邮箱linkserver链接，跳转前显示目标地址确认",
  "permissions": ["webNavigation"],
  "host_permissions": ["https://mail.hust.edu.cn:8443/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["redirect.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
